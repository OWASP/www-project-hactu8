// HACTU8 devcontainer (H-51): the Dockerfile's dev target. See docs/deploy.md.
// Python deps are pinned in /opt/venv (not the host's .venv); Node builds the console.
// The API and Vite bind the container's 127.0.0.1; VS Code forwards them to the host's.
{
  "name": "HACTU8",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "target": "dev"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/app,type=bind",
  "workspaceFolder": "/app",
  "remoteUser": "hactu8",
  "runArgs": ["--add-host=host.docker.internal:host-gateway"],
  "containerEnv": {
    "OLLAMA_HOST": "http://host.docker.internal:11434",
    "LLAMACPP_HOST": "http://host.docker.internal:8080"
  },
  // Linux node_modules in a volume, so the host's macOS node_modules stay untouched.
  "mounts": [
    "source=hactu8-console-node-modules,target=/app/spikes/iac-prototype/iac-host/node_modules,type=volume"
  ],
  "postCreateCommand": "sudo chown hactu8:hactu8 spikes/iac-prototype/iac-host/node_modules && npm ci --prefix spikes/iac-prototype/iac-host --no-audit --no-fund",
  "forwardPorts": [8000, 5173],
  "portsAttributes": {
    "8000": { "label": "HACTU8 API" },
    "5173": { "label": "Console (Vite)" }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "python.terminal.activateEnvironment": false
      },
      "extensions": ["ms-python.python", "DavidAnson.vscode-markdownlint"]
    }
  }
}
