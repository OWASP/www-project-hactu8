{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owasp.org/www-project-hactu8/schemas/result/v1.json",
  "title": "HACTU8 Result v1",
  "description": "One run of one HACTU8 skill: four acts (baseline, attack, impact, remediation), each item scored GREEN / YELLOW / RED.",
  "type": "object",
  "required": [
    "schema",
    "run_id",
    "hactu8_version",
    "started_at",
    "skill",
    "target",
    "model",
    "classifier",
    "acts",
    "summary",
    "exit_code"
  ],
  "properties": {
    "schema": {
      "const": "hactu8.result/v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-z0-9-]+$"
    },
    "hactu8_version": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "duration_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "skill": {
      "type": "object",
      "required": [
        "id",
        "name",
        "owasp",
        "metric"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "owasp": {
          "type": "string",
          "description": "OWASP id, e.g. LLM01:2026, ASI03:2026, or AGX01"
        },
        "risk": {
          "type": "string"
        },
        "metric": {
          "type": "object",
          "required": [
            "id",
            "name"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        }
      }
    },
    "target": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "lab",
            "url",
            "mcp",
            "lamb"
          ]
        },
        "id": {
          "type": "string"
        },
        "port": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "model": {
      "type": "object",
      "required": [
        "backend"
      ],
      "properties": {
        "backend": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "tier": {
          "type": "string",
          "description": "Router tier the model came from (hactu8.yaml)"
        },
        "escalated_from": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Candidates that failed before this one"
        },
        "think": {
          "type": "object",
          "description": "Reasoning control on a real backend (HACTU8_THINK / OLLAMA_THINK) and the reasoning the model returned apart from its answer",
          "required": [
            "mode",
            "sent"
          ],
          "properties": {
            "mode": {
              "enum": [
                "off",
                "on",
                "default"
              ]
            },
            "sent": {
              "type": "boolean",
              "description": "True when a request field carried the mode (ollama with off or on)"
            },
            "reasoning": {
              "type": "object",
              "description": "Totals of the labs' hactu8.reasoning lines; not graded",
              "properties": {
                "replies": {
                  "type": "integer",
                  "minimum": 0
                },
                "chars": {
                  "type": "integer",
                  "minimum": 0
                },
                "answer_cut_off": {
                  "type": "integer",
                  "minimum": 0
                },
                "canary_hits": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "classifier": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "enum": [
            "keyword",
            "llm-judge",
            "jev",
            "canary"
          ]
        },
        "role": {
          "type": "string"
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Judge models that scored at least one item"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "acts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "act",
          "phase",
          "title",
          "notes",
          "items",
          "metric"
        ],
        "properties": {
          "act": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "phase": {
            "enum": [
              "baseline",
              "attack",
              "impact",
              "remediation",
              "other"
            ]
          },
          "title": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "prompt",
                "targeted",
                "verdict",
                "confidence"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "prompt": {
                  "type": "string"
                },
                "targeted": {
                  "type": "boolean",
                  "description": "false for control items that must stay GREEN"
                },
                "verdict": {
                  "enum": [
                    "GREEN",
                    "YELLOW",
                    "RED",
                    "ERROR"
                  ],
                  "description": "ERROR is not a grade: the lab's call to the model under test failed for this item (evidence holds the error). It counts in neither red nor total"
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "reason": {
                  "type": "string"
                },
                "evidence": {
                  "type": "string",
                  "description": "What the model under test produced (answer, tool calls or steps), truncated"
                },
                "lab_verdict": {
                  "enum": [
                    "GREEN",
                    "YELLOW",
                    "RED",
                    "ERROR"
                  ],
                  "description": "The lab's own keyword verdict"
                },
                "held_by": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "No harm got through, but a later layer had to hold (a reply withheld, an action denied, budget spent off the task). Reported beside the verdict, never as a colour"
                },
                "classified_by": {
                  "type": "string",
                  "description": "Backend that produced the verdict, e.g. keyword or ollama:llama3.2:3b"
                },
                "surface": {
                  "type": "string",
                  "description": "Live runs: the MCP surface the item came from"
                },
                "outcome_off": {
                  "enum": [
                    "SAFE",
                    "BREACH"
                  ],
                  "description": "Live runs: outcome with no defense"
                },
                "outcome_on": {
                  "enum": [
                    "SAFE",
                    "DEFENDED",
                    "BREACH",
                    "FALSE_BLOCK"
                  ],
                  "description": "Live runs: outcome with the ProtectoGW gateway"
                }
              }
            }
          },
          "reported_rate": {
            "type": [
              "number",
              "null"
            ]
          },
          "metric": {
            "type": "object",
            "required": [
              "targeted",
              "overall"
            ],
            "properties": {
              "targeted": {
                "$ref": "#/$defs/rate"
              },
              "overall": {
                "$ref": "#/$defs/rate"
              }
            }
          },
          "protections": {
            "type": "array",
            "description": "Remediation act: the controls the hardened mode adds (Act 4 \"Protections added\"), resolved from hactu8/protections.py",
            "items": {
              "$ref": "#/$defs/protection"
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "baseline_rate",
        "impact_rate",
        "remediated_rate",
        "story_holds",
        "asserted",
        "status"
      ],
      "properties": {
        "baseline_rate": {
          "type": [
            "number",
            "null"
          ]
        },
        "impact_rate": {
          "type": [
            "number",
            "null"
          ]
        },
        "remediated_rate": {
          "type": [
            "number",
            "null"
          ]
        },
        "story_holds": {
          "type": "boolean"
        },
        "asserted": {
          "type": "boolean",
          "description": "true for deterministic backends, where the story is checked"
        },
        "errors": {
          "type": "integer",
          "minimum": 1,
          "description": "Items in the run whose model call failed (verdict ERROR); absent when none"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "reported",
            "error"
          ]
        }
      }
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "output": {
      "type": "string",
      "description": "Tail of the raw run output"
    },
    "wolf": {
      "type": "object",
      "description": "Present for `hactu8 wolf` runs: attacks written by an attacker model, screened, then graded like live runs by the per-run canary",
      "required": [
        "attacker",
        "rounds",
        "attempts_per_round",
        "sent",
        "rejected",
        "landed_off",
        "landed_on",
        "attempts"
      ],
      "properties": {
        "attacker": {
          "type": "object",
          "required": [
            "backend"
          ]
        },
        "rounds": {
          "type": "integer",
          "minimum": 1
        },
        "attempts_per_round": {
          "type": "integer",
          "minimum": 1
        },
        "sent": {
          "type": "integer"
        },
        "rejected": {
          "type": "integer",
          "description": "Generated attacks the safety screen refused to send"
        },
        "landed_off": {
          "type": "integer"
        },
        "landed_on": {
          "type": "integer"
        },
        "attempts": {
          "type": "array"
        },
        "den": {
          "type": "array",
          "description": "What the wolf den captured, canary redacted"
        }
      }
    },
    "live": {
      "type": "object",
      "description": "Present for `hactu8 live` runs: Lamb's MCP surfaces graded with the defense off and on, by the per-run canary",
      "required": [
        "attacks",
        "controls",
        "model_resistance",
        "breaches_off",
        "breaches_on",
        "defended_on",
        "false_blocks_on"
      ],
      "properties": {
        "attacks": {
          "type": "integer"
        },
        "controls": {
          "type": "integer"
        },
        "model_resistance": {
          "type": [
            "number",
            "null"
          ]
        },
        "breaches_off": {
          "type": "integer"
        },
        "breaches_on": {
          "type": "integer"
        },
        "defended_on": {
          "type": "integer"
        },
        "false_blocks_on": {
          "type": "integer"
        }
      }
    }
  },
  "$defs": {
    "rate": {
      "type": "object",
      "required": [
        "red",
        "total",
        "rate"
      ],
      "properties": {
        "red": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "errors": {
          "type": "integer",
          "minimum": 1,
          "description": "Items left out of red and total because the model call failed (verdict ERROR)"
        }
      }
    },
    "protection": {
      "type": "object",
      "required": [
        "id",
        "title",
        "idea",
        "steps",
        "before",
        "after"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "title": {
          "type": "string"
        },
        "idea": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "before": {
          "type": "string",
          "description": "Pseudocode sketch without the control"
        },
        "after": {
          "type": "string",
          "description": "Pseudocode sketch with the control"
        }
      }
    }
  }
}
