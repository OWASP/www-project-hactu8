{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owasp.org/www-project-hactu8/schemas/techniques/v1.json",
  "title": "HACTU8 Technique Catalog v1",
  "description": "Known attack techniques with their IDs in the main lists, the defenses that address them and the labs that demonstrate them (hactu8/techniques.py library()).",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "title", "family", "summary", "refs", "defenses", "labs"],
    "additionalProperties": false,
    "properties": {
      "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
      "title": {"type": "string", "minLength": 1},
      "family": {"type": "string", "minLength": 1},
      "summary": {"type": "string", "minLength": 1},
      "refs": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": false,
        "properties": {
          "owasp_llm_2026": {"$ref": "#/$defs/ids", "items": {"pattern": "^LLM(0[1-9]|10):2026$"}},
          "owasp_llm_2025": {"$ref": "#/$defs/ids", "items": {"pattern": "^LLM(0[1-9]|10):2025$"}},
          "owasp_asi_2026": {"$ref": "#/$defs/ids", "items": {"pattern": "^ASI(0[1-9]|10):2026$"}},
          "owasp_mcp_2025": {"$ref": "#/$defs/ids", "items": {"pattern": "^MCP(0[1-9]|10):2025$"}},
          "atlas": {"$ref": "#/$defs/ids", "items": {"pattern": "^AML\\.T\\d{4}(\\.\\d{3})?$"}},
          "nist": {"$ref": "#/$defs/ids", "items": {"pattern": "^NISTAML\\.0\\d{1,2}$"}}
        }
      },
      "defenses": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}},
      "labs": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+$"}}
    }
  },
  "$defs": {
    "ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
  }
}
