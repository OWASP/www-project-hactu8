# Copy to .env and adjust, or just export these in your shell.
# These configure the original src/ pipeline only; the template-based lab in
# owasp-llm05-poisoning-skill uses LLM05_PORT / LLM05_BACKEND / LLM05_MODEL.
# The demo runs with NONE of these set (echo is the default).

# Backend: echo (default, offline; aliases local, stub) | ollama | llamacpp | openrouter
LLM05_SRC_BACKEND=echo

# Chat model for the backend (empty = the provider's default).
# LLM05_SRC_MODEL=llama3.2:3b

# Embedding model on ollama / llamacpp (empty = local hashing embedding).
# LLM05_SRC_EMBED_MODEL=llama3.2:1b

# Number of documents retrieved and stuffed into the prompt.
LLM05_TOP_K=2

# Only for openrouter. Export it in your shell; never commit it.
# OPENROUTER_API_KEY=
