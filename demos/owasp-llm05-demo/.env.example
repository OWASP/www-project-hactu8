# Copy to .env and adjust, or just export these in your shell.
# These configure the original src/ pipeline only; the template-based lab in
# owasp-llm05-poisoning-skill uses LLM05_PORT / LLM05_BACKEND / LLM05_MODEL.
# The demo runs with NONE of these set (local backend is the default).

# Backend: "local" (default, no key needed) or "openai".
LLM05_SRC_BACKEND=local

# Number of documents retrieved and stuffed into the prompt.
LLM05_TOP_K=2

# Only needed when LLM05_SRC_BACKEND=openai:
# OPENAI_API_KEY=sk-...
# LLM05_CHAT_MODEL=gpt-4o-mini
# LLM05_EMBED_MODEL=text-embedding-3-small
